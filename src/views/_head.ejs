<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pointo — Gestion des heures</title>
  <link rel="stylesheet" href="/themes/<%= theme %>.css?v=<%= typeof assetVer !== 'undefined' ? assetVer : '1' %>">
  <link rel="stylesheet" href="/themebar.css?v=<%= typeof assetVer !== 'undefined' ? assetVer : '1' %>">
</head>
<body>
<header class="topbar"><div class="topbar-in">
  <a class="brand" href="/">Point<em>o</em></a>
  <nav>
    <% if (typeof user !== 'undefined' && user) { %>
      <% const nav = typeof navActive !== 'undefined' ? navActive : ''; %>
      <% if (user.is_admin) { %>
        <a href="/admin"<%- nav === 'report' ? ' aria-current="page"' : '' %>>Rapport</a>
        <a href="/admin/employees"<%- nav === 'employees' ? ' aria-current="page"' : '' %>>Employés</a>
      <% } else { %>
        <a href="/dashboard"<%- nav === 'dashboard' ? ' aria-current="page"' : '' %>>Mon punch</a>
      <% } %>
      <span class="who"><%= user.full_name %></span>
      <form action="/logout" method="post" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn ghost small">Déconnexion</button>
      </form>
    <% } %>
  </nav>
</div></header>
<main class="wrap <%= typeof wrapClass !== 'undefined' ? wrapClass : '' %>">
