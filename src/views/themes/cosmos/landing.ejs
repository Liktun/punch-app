<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pointo — Gestion des heures</title>
<link rel="stylesheet" href="/themes/<%= theme %>.css?v=<%= assetVer %>">
</head>
<body class="landing-body">
<%- include('../../_themebar_wrap') %>
<canvas id="cosmos" aria-hidden="true"></canvas>
  <main class="landing">
    <div class="planet"><span class="ring"></span><span class="body"></span></div>
    <p class="kicker">Gestion des heures · beta</p>
    <h1 class="hero-title">Point<span class="thin">o</span></h1>
    <p class="god-sub">Punch &amp; périodes de paie</p>
    <p class="landing-tag">Punch ton arrivée. Punch ton départ.<br>On compte le reste.</p>
    <a href="/login" class="circle-btn" style="justify-content:center;">
      <span class="ring">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </span>
      <span class="lbl">Se connecter</span>
    </a>
    <p class="landing-note">Périodes de paie bi-hebdomadaires · déplace ta souris</p>
  </main>

<script src="/cosmos.js?v=<%= assetVer %>"></script>
</body>
</html>
