<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mon punch — Pointo</title>
<link rel="stylesheet" href="/themes/<%= theme %>.css?v=<%= assetVer %>">
</head>
<body class="">
<%- include('../../_themebar_wrap') %>
<header class="topbar"><div class="topbar-in">
  <a class="brand" href="/"><span class="mark"></span>POINT<span class="k">O</span></a>
  <nav>
    <a href="/dashboard">Mon punch</a>
    <span class="who"><%= user.full_name %></span>
    <a href="/login">Déconnexion</a>
  </nav>
</div></header>

<main class="wrap">
  <div class="flash">
    <svg class="svg-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
    Arrivée enregistrée.
  </div>

  <section class="hero">
    <p class="greeting">Bonjour, <%= user.full_name.split(' ')[0] %> 👋</p>
    <div class="card artifact punch-card">
      <div class="bg-circle"></div>
      <div class="clock-big" id="clock">14:32:07</div>
      <% if (open) { %>
        <% if (openBreak) { %>
          <div class="shift-state on-break"><span class="live-dot break"></span><span>En pause</span></div>
          <div class="worked-now">
            <span class="worked-val break" id="breakTicker" data-start="<%= new Date(openBreak.break_in).getTime() %>">0h00</span>
            <span class="worked-label">pause depuis <%= fmtTimeOnly(openBreak.break_in) %></span>
          </div>
          <form action="/break/out" method="post">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="punch-btn resume" type="submit"><span class="punch-btn-icon">&#9654;</span> Reprendre le travail</button>
          </form>
        <% } else { %>
          <div class="shift-state"><span class="live-dot"></span><span>Quart en cours</span></div>
          <div class="worked-now">
            <span class="worked-val" id="ticker" data-start="<%= new Date(open.clock_in).getTime() %>">0h00</span>
            <span class="worked-label">depuis <%= fmtTimeOnly(open.clock_in) %></span>
          </div>
          <form action="/break/in" method="post">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="punch-btn pause" type="submit"><span class="punch-btn-icon">&#10073;&#10073;</span> Punch pause</button>
          </form>
          <form action="/punch/out" method="post" onsubmit="return confirm('Confirmer ton depart ?');">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="punch-btn out" type="submit"><span class="punch-btn-icon">&#9632;</span> Punch out</button>
          </form>
        <% } %>
      <% } else { %>
        <div class="shift-state idle"><span>Pret a commencer</span></div>
        <div class="worked-now"><span class="worked-label">Aucun quart en cours</span></div>
        <form action="/punch/in" method="post" onsubmit="return confirm('Confirmer ton arrivee ?');">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="punch-btn in" type="submit"><span class="punch-btn-icon">&#9654;</span> Punch in</button>
        </form>
      <% } %>
    </div>
  </section>

  <section class="card">
    <div class="summary-head">
      <p class="eyebrow" style="margin:0;">Cette période de paie</p>
      <span class="summary-sub"><%= periodLabel %></span>
    </div>
    <div class="big-total">
      <span class="big-total-val"><%= periodNet %></span>
      <span class="big-total-label">net travaillées</span>
    </div>
    <div class="chips">
      <span class="chip"><span class="chip-dot reg"></span><%= periodRegular %> régulières</span>
      <span class="chip"><span class="chip-dot ot"></span><%= periodOvertime %> supp.</span>
      <span class="chip"><span class="chip-dot brk"></span><%= periodBreak %> pauses</span>
      <span class="chip"><%= periodShifts %> quart<%= periodShifts > 1 ? 's' : '' %></span>
    </div>
  </section>

  <section class="card">
    <p class="section-title">Mes derniers punchs</p>
    <ul class="punch-list">
      <% if (recent.length === 0) { %>
        <li class="punch-item"><div class="empty">Aucun punch pour l'instant.</div></li>
      <% } %>
      <% recent.forEach((p) => { %>
      <li class="punch-item">
        <div class="punch-when"><span class="punch-day"><%= fmtDayShort(p.clock_in) %></span><span class="punch-times"><%= fmtTimeOnly(p.clock_in) %> <span class="punch-arrow">&rarr;</span> <%= p.clock_out ? fmtTimeOnly(p.clock_out) : 'en cours' %></span></div>
        <% if (p.clock_out) { %><span class="dur-pill"><%= fmtHours(new Date(p.clock_out) - new Date(p.clock_in)) %></span>
        <% } else { %><span class="dur-pill live"><span class="live-dot small"></span> en cours</span><% } %>
      </li>
      <% }) %>
    </ul>
  </section>
</main>
<footer class="foot">Pointo beta · heures calculées par période de paie bi-hebdomadaire</footer>
<script src="/dashboard.js?v=<%= assetVer %>"></script>
</body>
</html>
