<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rapport des heures — Pointo</title>
<link rel="stylesheet" href="/themes/<%= theme %>.css?v=<%= assetVer %>">
</head>
<body class="">
<%- include('../../_themebar_wrap') %>
<header class="topbar">
    <a class="brand" href="/">
      <span class="brand-badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2.5 2"></path><path d="M9 2h6"></path>
        </svg>
      </span>
      Pointo
    </a>
    <nav class="topnav">
      <a href="/admin" class="active">Rapport</a>
      <a href="/admin/employees">Employés</a>
    </nav>
    <div class="topbar-spacer"></div>
    <span class="topbar-who"><span class="avatar" aria-hidden="true">AD</span> <%= user.full_name %></span>
    <form action="/logout" method="post" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn-logout" type="submit">Déconnexion</button></form>
  </header>

  <main class="page">
    <h1 class="page-title">Rapport des heures</h1>
    <p class="page-sub">Vue consolidée de la période de paie courante.</p>

    <div class="period-nav">
      <a class="btn btn-ghost" href="/admin?p=<%= offset - 1 %>">← Précédente</a>
      <span class="period-label"><%= periodLabel %><% if (offset === 0) { %> <em>(courante)</em><% } %></span>
      <span class="btn btn-ghost" aria-disabled="true" style="opacity:.45;pointer-events:none;">Suivante →</span>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Employé</th><th class="num">Quarts</th><th class="num">Régulières</th>
            <th class="num">Supp.</th><th class="num">Net</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% if (report.length === 0) { %>
            <tr><td colspan="6" class="muted">Aucun employé actif.</td></tr>
          <% } %>
          <% report.forEach((r) => { %>
          <tr>
            <td class="emp"><%= r.name %> <small><%= r.username %></small></td>
            <td class="num"><%= r.shifts %><% if (r.openCount) { %> <span class="badge"><span class="dot"></span><%= r.openCount %> en cours</span><% } %></td>
            <td class="num"><%= r.regular %></td>
            <td class="num <%= r.hasOt ? 'ot-val' : 'muted' %>"><%= r.hasOt ? r.overtime : '—' %></td>
            <td class="num"><strong><%= r.net %></strong></td>
            <td><a class="link" href="/admin/employee/<%= r.id %>?p=<%= offset %>">Détail</a></td>
          </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <td><strong>Total de la période</strong></td>
            <td></td>
            <td class="num"><strong><%= grandReg %></strong></td>
            <td class="num"><strong class="ot-val"><%= grandOt %></strong></td>
            <td class="num"><strong><%= grandNet %></strong></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <p class="note">Heures supp. = au-delà de 40h/semaine (taux <%= otRate %>×). Pauses déduites automatiquement sur les longs quarts.</p>
  </main>
</body>
</html>
