<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mon punch — Pointo</title>
<link rel="stylesheet" href="/themes/<%= theme %>.css?v=<%= assetVer %>">
</head>
<body>
<%- include('../../_themebar_wrap') %>
<header class="topbar"><div class="topbar-in">
  <a class="brand" href="/">Point<em>o</em></a>
  <nav>
    <a href="/dashboard">Mon punch</a>
    <span class="who"><%= user.full_name %></span>
    <form action="/logout" method="post" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-logout" type="submit">Déconnexion</button></form>
  </nav>
</div></header>

<main class="wrap dash">
  <% if (flash) { %><div class="flash <%= flash.type === 'ok' ? 'ok' : 'warn' %>"><%= flash.msg %></div><% } %>

  <section class="hero">
    <p class="greeting"><%= user.full_name %></p>
    <div class="punch-card <%= open ? 'is-open' : '' %>">
      <div class="clock-big" id="clock">--:--:--</div>

      <% if (open) { %>
        <% if (openBreak) { %>
          <div class="shift-state on-break"><span class="live-dot break"></span><span>Pause en cours</span></div>
          <div class="worked-now">
            <span class="worked-val break" id="breakTicker" data-start="<%= new Date(openBreak.break_in).getTime() %>">0h00</span>
            <span class="worked-label">en pause depuis <%= fmtTimeOnly(openBreak.break_in) %></span>
          </div>
          <form action="/break/out" method="post">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="punch-btn resume" type="submit">Reprendre le travail</button>
          </form>
        <% } else { %>
          <div class="shift-state"><span class="live-dot"></span><span>Quart ouvert</span></div>
          <div class="worked-now">
            <span class="worked-val" id="ticker" data-start="<%= new Date(open.clock_in).getTime() %>">0h00</span>
            <span class="worked-label">depuis <%= fmtTimeOnly(open.clock_in) %></span>
          </div>
          <form action="/break/in" method="post">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="punch-btn pause" type="submit">Punch pause</button>
          </form>
          <form action="/punch/out" method="post" onsubmit="return confirm('Confirmer ton départ ?');">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="punch-btn out" type="submit">Punch out</button>
          </form>
        <% } %>
      <% } else { %>
        <div class="shift-state idle"><span>Aucun quart ouvert</span></div>
        <div class="worked-now">
          <span class="worked-val">0h00</span>
          <span class="worked-label">en attente d'une arrivée</span>
        </div>
        <form action="/punch/in" method="post" onsubmit="return confirm('Confirmer ton arrivée ?');">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="punch-btn in" type="submit">Punch in</button>
        </form>
      <% } %>
    </div>
  </section>

  <section class="card period-summary">
    <p class="eyebrow">Période courante</p>
    <div class="summary-head">
      <span class="summary-title">Cette période</span>
      <span class="summary-sub"><%= periodLabel %></span>
    </div>
    <div class="big-total">
      <span class="big-total-val"><%= periodNet %></span>
      <span class="big-total-label">net travaillées</span>
    </div>
    <div class="chips">
      <span class="chip"><%= periodRegular %> &nbsp;régulières</span>
      <span class="chip"><%= periodOvertime %> &nbsp;supplémentaires</span>
      <span class="chip"><%= periodBreak %> &nbsp;pauses déduites</span>
      <span class="chip muted-chip"><%= periodShifts %> quart<%= periodShifts > 1 ? 's' : '' %> <%= '' %></span>
    </div>
  </section>

  <section class="card">
    <p class="section-title">Derniers punchs</p>
    <ul class="punch-list">
      <% if (recent.length === 0) { %>
        <li><div class="empty">Aucun punch pour l'instant.</div></li>
      <% } %>
      <% recent.forEach((p) => { %>
      <li class="punch-item">
        <div class="punch-when">
          <span class="punch-day"><%= fmtDayShort(p.clock_in) %></span>
          <span class="punch-times"><%= fmtTimeOnly(p.clock_in) %> <span class="punch-arrow">&rarr;</span> <%= p.clock_out ? fmtTimeOnly(p.clock_out) : 'en cours' %></span>
        </div>
        <% if (p.clock_out) { %>
          <span class="dur-pill"><%= fmtHours(new Date(p.clock_out) - new Date(p.clock_in)) %></span>
        <% } else { %>
          <span class="dur-pill live"><span class="live-dot small"></span> ouvert</span>
        <% } %>
      </li>
      <% }) %>
    </ul>
  </section>
</main>
<footer class="foot">Pointo beta · heures calculées par période de paie bi-hebdomadaire</footer>
<script src="/dashboard.js?v=<%= assetVer %>"></script>
</body>
</html>
