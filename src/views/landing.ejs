<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pointo — Gestion des heures</title>
  <link rel="stylesheet" href="/themes/<%= theme %>.css?v=<%= assetVer %>">
  <link rel="stylesheet" href="/base.css?v=<%= assetVer %>">
</head>
<body class="<%= (typeof preview !== 'undefined' && preview) ? 'preview-page' : 'landing-body' %>">
  <% if (typeof preview !== 'undefined' && preview) { %>
    <div class="preview-banner">Aperçu — cet écran est une démonstration</div>
    <div class="wrap preview-tools"><%- include('_themebar') %></div>
  <% } %>

  <main class="landing">
    <p class="kicker">Gestion des heures · beta</p>
    <h1>Point<em>o</em></h1>
    <p class="landing-tag">Punch ton arrivée. Punch ton départ.<br>On compte le reste.</p>
    <a href="/login" class="btn primary big landing-cta">Se connecter</a>
    <div class="rule"></div>
    <p class="landing-note">Périodes de paie bi-hebdomadaires</p>
  </main>
</body>
</html>
