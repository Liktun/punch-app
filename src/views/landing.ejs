<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pointo — Gestion des heures</title>
  <%# base first, then the theme, so themes can override structural defaults %>
  <link rel="stylesheet" href="/base.css?v=<%= assetVer %>">
  <link rel="stylesheet" href="/themes/<%= theme %>.css?v=<%= assetVer %>">
</head>
<body class="<%= (typeof preview !== 'undefined' && preview) ? 'preview-page' : 'landing-body' %>">
  <% if (typeof preview !== 'undefined' && preview) { %>
    <div class="preview-banner">Aperçu — cet écran est une démonstration</div>
    <div class="wrap preview-tools"><%- include('_themebar') %></div>
  <% } %>

  <main class="landing">
    <%# Decorative mark. Each theme styles (or hides) these layers, so one
        markup can render an orbit, a planet, a sun or nothing at all. %>
    <div class="hero-mark" aria-hidden="true">
      <span class="ring r1"></span>
      <span class="ring r2"></span>
      <span class="ring r3"></span>
      <span class="orbiter a"></span>
      <span class="orbiter b"></span>
      <span class="core"></span>
    </div>

    <p class="kicker">Gestion des heures · beta</p>
    <h1 class="wordmark">Point<em>o</em></h1>
    <p class="tagline-sub">Punch &amp; périodes de paie</p>
    <p class="landing-tag">Punch ton arrivée. Punch ton départ.<br>On compte le reste.</p>
    <a href="/login" class="btn primary big landing-cta">Se connecter</a>
    <div class="rule"></div>
    <p class="landing-note">Périodes de paie bi-hebdomadaires</p>
  </main>
</body>
</html>
