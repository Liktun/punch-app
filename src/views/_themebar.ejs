<%# Admin-only theme selector + screen previews. Applies app-wide for everyone.
    `screen` marks which preview is currently shown so the bar stays in place
    and simply highlights the active screen. %>
<% const cur = typeof screen !== 'undefined' ? screen : 'admin'; %>
<div class="theme-bar">
  <div class="theme-bar-head">
    <span class="theme-bar-title">Thème de l'application</span>
    <span class="theme-bar-current">
      Actif : <b><%= (themes.find((t) => t.id === theme) || {}).label %></b>
    </span>
  </div>

  <div class="theme-list">
    <% themes.forEach((t) => { %>
      <form action="/admin/theme" method="post">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="theme" value="<%= t.id %>">
        <input type="hidden" name="back" value="<%= cur %>">
        <button class="theme-opt" type="submit" title="<%= t.hint %>"
          <%- t.id === theme ? 'aria-current="true"' : '' %>><%= t.label %></button>
      </form>
    <% }) %>
  </div>

  <div class="theme-bar-screens">
    <span class="theme-bar-title">Aperçu des écrans</span>
    <div class="screen-list">
      <a class="screen-opt" href="/preview/landing"   <%- cur === 'landing'   ? 'aria-current="true"' : '' %>>Accueil</a>
      <a class="screen-opt" href="/preview/login"     <%- cur === 'login'     ? 'aria-current="true"' : '' %>>Connexion</a>
      <a class="screen-opt" href="/preview/dashboard" <%- cur === 'dashboard' ? 'aria-current="true"' : '' %>>Employé</a>
      <a class="screen-opt" href="/admin"             <%- cur === 'admin'     ? 'aria-current="true"' : '' %>>Admin</a>
    </div>
  </div>
</div>
